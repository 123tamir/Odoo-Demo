<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="sales_dashboard.Dashboard">
        <div class="o_sd_dashboard h-100 overflow-auto p-4">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="m-0">Sales Dashboard</h2>
                <div class="d-flex align-items-center gap-2">
                    <span>From</span>
                    <input type="date" class="form-control w-auto"
                           t-att-value="state.dateFrom"
                           t-on-change="(ev) => this.onDateChange('dateFrom', ev)"/>
                    <span>To</span>
                    <input type="date" class="form-control w-auto"
                           t-att-value="state.dateTo"
                           t-on-change="(ev) => this.onDateChange('dateTo', ev)"/>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-3">
                    <div class="card o_sd_kpi p-3">
                        <div class="text-muted">Total Sales</div>
                        <div class="o_sd_kpi_value"><t t-esc="fmtMoney(state.data.total_sales)"/></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card o_sd_kpi p-3">
                        <div class="text-muted">Confirmed Orders</div>
                        <div class="o_sd_kpi_value"><t t-esc="state.data.order_count"/></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card o_sd_kpi p-3">
                        <div class="text-muted">Avg Order Value</div>
                        <div class="o_sd_kpi_value"><t t-esc="fmtMoney(state.data.avg_order)"/></div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card o_sd_kpi o_sd_kpi_warn p-3">
                        <div class="text-muted">Low Stock Items</div>
                        <div class="o_sd_kpi_value"><t t-esc="state.data.low_stock_count"/></div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card p-3">
                        <h5>Monthly Trend</h5>
                        <div style="height: 300px;"><canvas t-ref="trendChart"/></div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card p-3">
                        <h5>Top 5 Products</h5>
                        <div style="height: 300px;"><canvas t-ref="productChart"/></div>
                    </div>
                </div>
            </div>

            <div class="card p-3">
                <h5>Low Stock Alert</h5>
                <table class="table table-sm mb-0">
                    <thead>
                        <tr><th>Product</th><th>In Stock</th><th>Reorder Level</th></tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="state.data.low_stock" t-as="p" t-key="p.id">
                            <td><t t-esc="p.name"/></td>
                            <td class="text-danger"><t t-esc="p.stock_qty"/></td>
                            <td><t t-esc="p.reorder_level"/></td>
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    </t>
</templates>